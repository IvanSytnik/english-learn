{
  "extends": "@englishlearn/config/tsconfig/library.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    // Consumed as TS source, never emitted. Declaration checks would fail on the
    // generated prisma-client sources (TS4094: #private in exported classes).
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "src/generated/**"]
}
