{
  "name": "@englishlearn/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./localization": "./src/localization/index.ts",
    "./examples": "./src/examples/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "vocab:localize": "tsx --env-file-if-exists=../db/.env scripts/localize-cefr-j.ts",
    "clean": "rm -rf dist .turbo node_modules",
    "vocab:examples": "tsx --env-file-if-exists=../db/.env scripts/generate-examples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@englishlearn/db": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@englishlearn/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
