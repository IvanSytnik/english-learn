{
  "extends": "@englishlearn/config/tsconfig/library.json",
  "compilerOptions": {
    // Never emitted; the root spans the workspace sources reached through @englishlearn/db.
    "rootDir": "../..",
    "noEmit": true,
    // Consumed as TS source, never emitted. Declaration checks would fail on the
    // generated prisma-client sources reached through @englishlearn/db (TS4094).
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
