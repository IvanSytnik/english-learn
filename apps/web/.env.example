# Copy to apps/web/.env AND packages/db/.env (the Prisma CLI does not read
# env files from sibling packages). On Vercel, set these in
# Project Settings → Environment Variables — never commit real values.

# ─── Required ───────────────────────────────────────────────
# Neon *pooled* connection string (host contains `-pooler`) — used at runtime.
# connect_timeout gives Neon time to wake from auto-suspend.
DATABASE_URL="postgresql://user:password@ep-something-pooler.eu-central-1.aws.neon.tech/englishlearn?sslmode=require&connect_timeout=15"

# Neon *direct* connection string (same host without `-pooler`) — used by
# `prisma migrate`. DDL through the pooler silently no-ops.
DIRECT_URL="postgresql://user:password@ep-something.eu-central-1.aws.neon.tech/englishlearn?sslmode=require"

# Auth.js v5 secret. Generate with: openssl rand -base64 32
# Use a different value per environment (local / preview / production).
AUTH_SECRET="replace-me-with-a-strong-random-string"

# ─── Optional ───────────────────────────────────────────────
# AUTH_URL is auto-detected on Vercel; set manually for self-hosted.
# AUTH_URL="http://localhost:3000"

# Google OAuth (provider not wired up yet)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# AI providers (clients not wired up yet)
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# Skip env validation at build time (CI, Docker image builds)
# SKIP_ENV_VALIDATION=1
